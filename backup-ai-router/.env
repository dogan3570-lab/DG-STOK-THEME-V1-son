# Backup AI Router - Environment Configuration
# Bu dosya DG-STOK'tan BAĞIMSIZDİR

# Server
PORT=4100

# OmniRoute (localhost:20128 - zaten çalışıyor)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=omni

# NVIDIA (API key'inizi buraya yazın)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter (API key'inizi buraya yazın)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
