import React, { useEffect, useState } from 'react';
import {
  profitEngineSummary, profitEngineAnomalies, profitEngineLearning, profitEngineCalculate,
  profitEngineLearnStats, profitEngineLearnInsights, profitEngineLearnAlerts,
  profitEngineLearnAccuracy, profitEngineLearnDataStatus, profitEngineLearnSimulate,
} from '../lib/api';

interface ProfitEngineSummary {
  totalRevenue: number;
  totalCost: number;
  totalProfit: number;
  totalLoss: number;
  netProfit: number;
  profitMargin: number;
  orderCount: number;
  productCount: number;
  returnCount: number;
  returnRate: number;
  avgOrderValue: number;
  topMarketplace: string;
  topProducts: Array<{
    productId: string;
    sku: string;
    title: string;
    revenue: number;
    cost: number;
    profit: number;
    margin: number;
    orderCount: number;
  }>;
  dailyTrend: Array<{
    date: string;
    revenue: number;
    cost: number;
    profit: number;
    orderCount: number;
  }>;
}

interface AnomalyData {
  total: number;
  byType: Record<string, number>;
  bySeverity: Record<string, number>;
  critical: any[];
  unresolved: any[];
}

interface LearningData {
  totalRules: number;
  activeRules: number;
  avgConfidence: number;
  byType: Record<string, number>;
  verifiedRules: number;
  lastUpdated: string;
  commercial?: {
    totalObservations: number;
    totalDeviations: number;
    totalInsights: number;
    totalAlerts: number;
    unacknowledgedAlerts: number;
  };
}

interface LearnInsight {
  id: string;
  marketplaceKey: string;
  category?: string;
  metric: string;
  officialValue: number | null;
  officialSource: string | null;
  learnedValue: number;
  deviationFromOfficial: number | null;
  sampleCount: number;
  confidence: number;
  status: 'emerging' | 'confirmed' | 'divergent';
  firstSeen: string;
  lastSeen: string;
}

interface LearnAlert {
  id: string;
  type: string;
  severity: 'info' | 'warning' | 'critical';
  marketplaceKey: string;
  metric: string;
  title: string;
  message: string;
  recommendation: string;
  acknowledged: boolean;
  timestamp: string;
}

interface LearnStats {
  totalObservations: number;
  totalDeviations: number;
  totalInsights: number;
  totalAlerts: number;
  unacknowledgedAlerts: number;
  avgConfidence: number;
  byMarketplace: Record<string, { observations: number; deviations: number; avgConfidence: number }>;
  byMetric: Record<string, { deviations: number; avgDeviationPercent: number }>;
}

interface LearnAccuracy {
  accuracy: number;
  totalObservations: number;
  withinThreshold: number;
}

interface LearnDataStatus {
  realDataAvailable: boolean;
  counts: {
    orderCount: number;
    productCount: number;
    templateCount: number;
    withPurchasePrice: number;
    withCommissionRate: number;
    withCargoSettings: number;
  };
  gaps: string[];
}

interface ProfitEngineCalculation {
  grossSales: number;
  discount: number;
  netSales: number;
  productCost: number;
  commission: number;
  shippingCost: number;
  serviceFee: number;
  stopaj: number;
  advertising: number;
  marketing: number;
  returnCost: number;
  otherExpenses: number;
  vatPayable: number;
  operationalProfit: number;
  netProfit: number;
  profitMargin: number;
  roi: number;
  currency: string;
  calculationVersion: string;
  calculatedAt: string;
  source: any;
}

export default function FinancePage() {
  const [summary, setSummary] = useState<any>(null);
  const [anomalies, setAnomalies] = useState<AnomalyData | null>(null);
  const [learning, setLearning] = useState<LearningData | null>(null);
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState<'genel' | 'gelir' | 'gider' | 'kar' | 'anomali' | 'ogrenme'>('genel');
  const [loadingSummary, setLoadingSummary] = useState(true);
  const [loadingAnomalies, setLoadingAnomalies] = useState(true);
  const [loadingLearning, setLoadingLearning] = useState(true);

  // Calculator state
  const [calcInput, setCalcInput] = useState({
    grossSales: 200,
    discount: 0,
    productCost: 50,
    commission: 15,
    shippingCost: 6,
    serviceFee: 1,
    stopaj: 0,
    advertising: 0,
    marketing: 0,
    returnCost: 0,
    otherExpenses: 4,
    vatRate: 20,
  });
  const [calcResult, setCalcResult] = useState<any>(null);
  const [calcLoading, setCalcLoading] = useState(false);

  // Learning state
  const [learningBefore, setLearningBefore] = useState<number | null>(null);
  const [learningAfter, setLearningAfter] = useState<number | null>(null);
  const [prediction1, setPrediction1] = useState<number | null>(null);
  const [prediction2, setPrediction2] = useState<number | null>(null);

  // Commercial learning state (gerçek veri)
  const [learnStats, setLearnStats] = useState<LearnStats | null>(null);
  const [learnInsights, setLearnInsights] = useState<LearnInsight[]>([]);
  const [learnAlerts, setLearnAlerts] = useState<LearnAlert[]>([]);
  const [learnAccuracy, setLearnAccuracy] = useState<LearnAccuracy | null>(null);
  const [learnDataStatus, setLearnDataStatus] = useState<LearnDataStatus | null>(null);
  const [simLoading, setSimLoading] = useState(false);
  const [simResult, setSimResult] = useState<any>(null);

  useEffect(() => {
    fetchSummary();
    fetchAnomalies();
    fetchLearning();
    fetchLearn();
  }, []);

  async function fetchLearn() {
    try {
      const [statsRes, insRes, alertRes, accRes, dsRes] = await Promise.all([
        profitEngineLearnStats(),
        profitEngineLearnInsights(),
        profitEngineLearnAlerts(),
        profitEngineLearnAccuracy(),
        profitEngineLearnDataStatus(),
      ]);
      if (statsRes.ok) setLearnStats(statsRes.data as LearnStats);
      if (insRes.ok) setLearnInsights(((insRes.data as any)?.items as LearnInsight[]) || []);
      if (alertRes.ok) setLearnAlerts(((alertRes.data as any)?.items as LearnAlert[]) || []);
      if (accRes.ok) setLearnAccuracy(accRes.data as LearnAccuracy);
      if (dsRes.ok) setLearnDataStatus(dsRes.data as LearnDataStatus);
    } catch (err) {
      console.error('Failed to fetch commercial learning:', err);
    }
  }

  async function handleSimulate() {
    setSimLoading(true);
    try {
      const res = await profitEngineLearnSimulate([
        {
          orderId: 'sim-ui-1',
          marketplaceKey: 'tt',
          category: 'Ornek',
          expected: { commissionRate: 12, shippingCost: 8, returnRate: 2, discountRate: 5, advertisingCost: 3 },
          actual: { commissionRate: 15, shippingCost: 9, returnRate: 2, discountRate: 5, advertisingCost: 3 },
          orderTotal: 100,
        },
      ]);
      if (res.ok) setSimResult(res.data);
      else setSimResult({ error: res.error });
      // Simülasyon izole: üretim state'i değişmemeli, ama yine de tazele
      fetchLearn();
    } catch (err) {
      console.error('Simulation failed:', err);
    } finally {
      setSimLoading(false);
    }
  }

  async function fetchSummary() {
    try {
      const res = await profitEngineSummary();
      if (res.ok && res.data) {
        setSummary(res.data);
      }
    } catch (err) {
      console.error('Failed to fetch summary:', err);
    }
  }

  async function fetchAnomalies() {
    try {
      const res = await profitEngineAnomalies();
      if (res.ok && res.data) {
        setAnomalies(res.data);
      }
    } catch (err) {
      console.error('Failed to fetch anomalies:', err);
    }
  }

  async function fetchLearning() {
    try {
      const res = await profitEngineLearning();
      if (res.ok && res.data) {
        setLearning(res.data);
      }
    } catch (err) {
      console.error('Failed to fetch learning:', err);
    }
  }

  async function handleCalculate() {
    setCalcLoading(true);
    try {
      const res = await profitEngineCalculate(calcInput);
      if (res.ok && res.data) {
        setCalcResult(res.data);
      }
    } catch (err) {
      console.error('Calculation failed:', err);
    } finally {
      setCalcLoading(false);
    }
  }

  function formatPrice(v: number | null | undefined) {
    return v != null ? v.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' }) : '₺0';
  }

  function getTypeIcon(type: string) {
    const icons: Record<string, string> = { sale: '💰', purchase: '📥', commission: '🏦', cargo: '🚚', advertising: '📢', return: '🔄', vat: '🧾', profit: '📈' };
    return icons[type] || '💳';
  }

  function getTypeLabel(type: string) {
    const labels: Record<string, string> = { sale: 'Satış', purchase: 'Alış', commission: 'Komisyon', cargo: 'Kargo', advertising: 'Reklam', return: 'İade', vat: 'KDV', profit: 'Kar', cargo_income: 'Kargo Geliri', service: 'Hizmet', coupon: 'Kupon', packaging: 'Paketleme', bank_fee: 'Banka', other_income: 'Diğer Gelir', other: 'Diğer' };
    return labels[type] || type;
  }

  return (
    <div className="space-y-6">
      {/* Üst Kontroller */}
      <div className="flex flex-wrap items-center gap-4 px-4 pt-4 bg-white dark:bg-slate-800/40 rounded-xl shadow-sm">
        <div className="flex-1 min-w-[200px]">
          <label className="block text-sm font-medium text-current mb-1">Dönem</label>
          <div className="flex gap-2">
            <button className="px-3 py-1.5 bg-primary text-white rounded-lg font-medium">Ay</button>
            <button className="px-3 py-1.5 bg-slate-200 dark:bg-slate-800/50 text-current rounded-lg hover:bg-slate-300 dark:hover:bg-slate-700">Hafta</button>
            <button className="px-3 py-1.5 bg-slate-200 dark:bg-slate-800/50 text-current rounded-lg hover:bg-slate-300 dark:hover:bg-slate-700">Yıl</button>
          </div>
        </div>
        <div className="flex-1 min-w-[200px]">
          <label className="block text-sm font-medium text-current mb-1">Pazaryeri</label>
          <select className="w-full px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50">
            <option value="">Tümü</option>
            <option value="tt">Trendyol</option>
            <option value="he">Hepsiburada</option>
            <option value="n11">N11</option>
          </select>
        </div>
        <div className="flex-1 min-w-[200px]">
          <label className="block text-sm font-medium text-current mb-1">Ürün Ara</label>
          <input type="text" placeholder="Ürün adı / SKU / Barkod" className="w-full px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
        </div>
        <div className="flex-1 min-w-[120px]">
          <label className="block text-sm font-medium text-current mb-1">Tarih Aralığı</label>
          <input type="date" className="w-full px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
          <input type="date" className="w-full mt-2 px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
        </div>
        <div className="flex-shrink-0">
          <button onClick={() => window.location.reload()} className="btn-primary px-4 py-2 rounded-lg font-medium flex items-center gap-2">
            🔄 Yenile
          </button>
        </div>
      </div>

      {/* Ana KPI Kartları */}
      <div className="grid gap-6 px-4 pb-4">
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
            <div className="text-sm font-medium text-current mb-2">💰 Ciro (Brüt Satış)</div>
            <div className="text-2xl font-bold text-current">{formatPrice(summary?.totalRevenue)}</div>
          </div>
          <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
            <div className="text-sm font-medium text-current mb-2">📈 Net Satış</div>
            <div className="text-2xl font-bold text-current">{formatPrice(summary?.netSales)}</div>
          </div>
          <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
            <div className="text-sm font-medium text-current mb-2">💸 Toplam Maliyet</div>
            <div className="text-2xl font-bold text-current">{formatPrice(summary?.totalCost)}</div>
          </div>
          <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
            <div className="text-sm font-medium text-current mb-2">✅ Net Kâr</div>
            <div className="text-2xl font-bold text-green-600">{formatPrice(summary?.netProfit)}</div>
          </div>
          <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
            <div className="text-sm font-medium text-current mb-2">📊 Kâr Marjı</div>
            <div className="text-2xl font-bold text-current">{summary?.profitMargin != null ? `%${summary.profitMargin.toFixed(1)}` : 'VERİ YOK'}</div>
          </div>
          <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
            <div className="text-sm font-medium text-current mb-2">🚀 ROI</div>
            <div className="text-2xl font-bold text-current">{summary?.roi != null ? `%${summary.roi.toFixed(1)}` : 'VERİ YOK'}</div>
          </div>
        </div>
      </div>

      {/* Sekmeler */}
      <div className="px-4">
        <div className="flex gap-1 rounded-xl border border-slate-200 dark:border-slate-800/60 bg-white dark:bg-slate-800/40">
          {['genel', 'gelir', 'gider', 'kar', 'anomali', 'öğrenme'].map(tab => (
            <button key={tab} onClick={() => setActiveTab(tab as any)}
              data-testid={`tab-${tab}`}
              className={`flex-1 rounded-lg px-4 py-3 text-sm font-medium transition-colors ${activeTab === tab ? 'bg-primary/10 text-primary' : 'text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary'}`}>
              {tab === 'genel' ? '📊 Genel' : tab === 'gelir' ? '💰 Gelir' : tab === 'gider' ? '📤 Gider' : tab === 'kar' ? '📈 Kar' : tab === 'anomali' ? '⚠️ Anomali' : '🧠 Öğrenme'}
            </button>
          ))}
        </div>
      </div>

      {/* İçerik */}
      <div className="px-4 pb-6">
        {/* ===== GENEL TAB ===== */}
        {activeTab === 'genel' && (
          <div className="space-y-6">
            {/* Kâr Dağılımı (Waterfall) */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">📉 Kâr Dağılımı</h3>
              <div className="space-y-3">
                <div className="flex items-center justify-between text-current">
                  <span>Brüt Satış</span>
                  <span className="font-mono">{formatPrice(summary?.totalRevenue)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>İndirim</span>
                  <span className="font-mono">{formatPrice(summary?.discount)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Komisyon</span>
                  <span className="font-mono">{formatPrice(summary?.commission)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Kargo</span>
                  <span className="font-mono">{formatPrice(summary?.shipping)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Hizmet ve Diğer Giderler</span>
                  <span className="font-mono">{formatPrice(((summary?.serviceFee||0)+(summary?.otherExpenses||0)))}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Ürün Maliyeti</span>
                  <span className="font-mono">{formatPrice(summary?.purchaseCost)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Vergi Etkileri (KDV Net)</span>
                  <span className="font-mono">{formatPrice(summary?.netVat)}</span>
                </div>
                <div className="flex items-center justify-between border-t border-slate-200 dark:border-slate-800/60 pt-4">
                  <span className="font-bold text-current">NET KÂR</span>
                  <span className="font-bold text-green-600">{formatPrice(summary?.netProfit)}</span>
                </div>
              </div>
            </div>

            {/* Kâr Değişimi (Trend) */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">📈 Kâr Değişimi (Trend)</h3>
              <div id="trend-chart" className="h-96 bg-slate-50 dark:bg-slate-800/20 rounded-lg">
                {/* Grafik placeholder - gerçek veri gelecek */}
                <div className="flex h-full items-center justify-center text-slate-500 dark:text-slate-400">
                  Bu dönem için yeterli finansal veri bulunmuyor
                </div>
              </div>
            </div>

            {/* Ürün Kârlılık Analizi */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">🛍️ Ürün Kârlılık Analizi</h3>
              <div className="space-y-4">
                <div className="flex flex-wrap gap-3">
                  <input type="text" placeholder="Ürün adı / SKU / Barkod" className="flex-1 min-w-[200px] px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                  <button className="btn-primary px-4 py-2 rounded-lg font-medium">Ara</button>
                </div>
                <div className="mt-4">
                  <div className="text-sm text-current text-center py-4">Ürün seçildiğinde detaylı kârlılık görünür.</div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ===== GELİR TAB ===== */}
        {activeTab === 'gelir' && (
          <div className="space-y-6">
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">💰 Gelir Detayları</h3>
              <div className="space-y-3">
                <div className="flex items-center justify-between text-current">
                  <span>Brüt Satış</span>
                  <span className="font-mono">{formatPrice(summary?.totalRevenue)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>İndirimler</span>
                  <span className="font-mono">{formatPrice(summary?.discount)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Net Satış</span>
                  <span className="font-mono">{formatPrice(summary?.netSales)}</span>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ===== GIDER TAB ===== */}
        {activeTab === 'gider' && (
          <div className="space-y-6">
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">💸 Gider Detayları</h3>
              <div className="space-y-3">
                <div className="flex items-center justify-between text-current">
                  <span>Ürün Maliyeti</span>
                  <span className="font-mono">{formatPrice(summary?.purchaseCost)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Komisyon</span>
                  <span className="font-mono">{formatPrice(summary?.commission)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Kargo</span>
                  <span className="font-mono">{formatPrice(summary?.shipping)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Hizmet ve Diğer Giderler</span>
                  <span className="font-mono">{formatPrice(((summary?.serviceFee||0)+(summary?.otherExpenses||0)))}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Vergi Etkileri (KDV Net)</span>
                  <span className="font-mono">{formatPrice(summary?.netVat)}</span>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ===== KAR TAB ===== */}
        {activeTab === 'kar' && (
          <div className="space-y-6">
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">✅ Net Kâr Detayları</h3>
              <div className="space-y-3">
                <div className="flex items-center justify-between text-current">
                  <span>Net Kâr</span>
                  <span className="font-bold text-green-600">{formatPrice(summary?.netProfit)}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Kâr Marjı</span>
                  <span className="font-bold">{summary?.profitMargin != null ? `%${summary.profitMargin.toFixed(1)}` : 'VERİ YOK'}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>ROI</span>
                  <span className="font-bold">{summary?.roi != null ? `%${summary.roi.toFixed(1)}` : 'VERİ YOK'}</span>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ===== ANOMALİ TAB ===== */}
        {activeTab === 'anomali' && (
          <div className="space-y-6">
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">⚠️ Anomali Tespiti</h3>
              <div className="space-y-3">
                <div className="flex items-center justify-between text-current">
                  <span>Toplam Anomali</span>
                  <span className="font-mono text-red-600">{anomalies?.total ?? 0}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Kritik Anomaliler</span>
                  <span className="font-mono text-red-600">{anomalies?.bySeverity?.CRITICAL ?? 0}</span>
                </div>
                <div className="flex items-center justify-between text-current">
                  <span>Çözülmemiş Anomaliler</span>
                  <span className="font-mono">{anomalies?.unresolved?.length ?? 0}</span>
                </div>
              </div>
              {anomalies?.unresolved?.length ? (
                <div className="mt-4">
                  <h4 className="text-sm font-medium text-current mb-2">Çözülmemiş Anomaliler Listesi</h4>
                  <div className="space-y-2">
                    {anomalies.unresolved.map((a: any, i: number) => (
                      <div key={i} className="p-3 bg-slate-50 dark:bg-slate-800/30 rounded-lg">
                        <div className="flex items-center justify-between text-sm">
                          <span>{getTypeIcon(a.type)}</span>
                          <span className="flex-1">{a.details}</span>
                          <span className="text-xs">{a.orderId} • {a.marketplaceKey}</span>
                        </div>
                        <div className="mt-1 flex items-center gap-2">
                          <span className={`px-2 py-0.5 rounded text-xs ${a.severity === 'CRITICAL' ? 'bg-red-500/20 text-red-600' : a.severity === 'HIGH' ? 'bg-orange-500/20 text-orange-600' : 'bg-yellow-500/20 text-yellow-600'}`}>{a.severity}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <div className="text-sm text-current text-center py-4">Anomali bulunamadı</div>
              )}
            </div>
          </div>
        )}

        {/* ===== ÖĞRENME TAB ===== */}
        {activeTab === 'öğrenme' && (
          <div className="space-y-6">
            {/* Gerçek veri durumu */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">📡 Gerçek Veri Durumu</h3>
              {!learnDataStatus ? (
                <div className="text-sm text-current">Veri durumu yükleniyor...</div>
              ) : learnDataStatus.realDataAvailable ? (
                <div className="text-sm text-emerald-600 dark:text-emerald-400">Gerçek ticari veri mevcut — öğrenme gerçek veriyle beslenebilir.</div>
              ) : (
                <div className="space-y-3">
                  <div className="text-sm font-medium text-amber-600 dark:text-amber-400">Henüz yeterli gerçek veri yok — öğrenme motoru gerçek sipariş verisiyle beslenemiyor.</div>
                  <ul className="text-xs text-current list-disc pl-5 space-y-0.5">
                    {learnDataStatus.gaps.map((g, i) => <li key={i}>{g}</li>)}
                  </ul>
                  <div className="mt-2 text-xs text-current">
                    Sipariş: <b>{learnDataStatus.counts.orderCount}</b> · Alış fiyatı dolu ürün: <b>{learnDataStatus.counts.withPurchasePrice}</b>/{learnDataStatus.counts.productCount} · Resmi komisyon dolu template: <b>{learnDataStatus.counts.withCommissionRate}</b>/{learnDataStatus.counts.templateCount}
                  </div>
                </div>
              )}
            </div>

            {/* Öğrenme KPI */}
            <div className="grid gap-4 px-4 pb-4">
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div className="panel-theme p-5 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
                  <div className="text-sm font-medium text-current mb-2">👁️ Gözlem Sayısı</div>
                  <div className="text-2xl font-bold text-current">{learnStats?.totalObservations ?? 0}</div>
                </div>
                <div className="panel-theme p-5 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
                  <div className="text-sm font-medium text-current mb-2">💡 Öğrenilen Bilgi Sayısı</div>
                  <div className="text-2xl font-bold text-current">{learnStats?.totalInsights ?? 0}</div>
                </div>
                <div className="panel-theme p-5 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
                  <div className="text-sm font-medium text-current mb-2">📉 Toplam Sapma</div>
                  <div className="text-2xl font-bold text-current">{learnStats?.totalDeviations ?? 0}</div>
                </div>
                <div className="panel-theme p-5 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
                  <div className="text-sm font-medium text-current mb-2">🔔 Okunmamış Uyarı</div>
                  <div className="text-2xl font-bold text-current">{learnStats?.unacknowledgedAlerts ?? 0}</div>
                </div>
                <div className="panel-theme p-5 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
                  <div className="text-sm font-medium text-current mb-2">🎯 Tahmin Doğruluğu</div>
                  <div className="text-2xl font-bold text-current">{learnAccuracy ? `%${(learnAccuracy.accuracy * 100).toFixed(1)}` : '—'}</div>
                </div>
              </div>
            </div>

            {/* Öğrenilen Bilgiler Tablosu */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">🧠 Öğrenilen Bilgiler (Resmî / Gözlemlenen / Öğrenilmiş / Tahmini)</h3>
              {learnInsights.length === 0 ? (
                <div className="text-sm text-current text-center py-4">Henüz öğrenilen bilgi yok. Yeterli gerçek gözlem oluştuğunda burada görünür.</div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full text-xs">
                    <thead>
                      <tr className="text-current border-b border-slate-200 dark:border-slate-700">
                        <th className="text-left py-1.5 pr-2">Pazaryeri</th>
                        <th className="text-left py-1.5 pr-2">Kategori</th>
                        <th className="text-left py-1.5 pr-2">Metrik</th>
                        <th className="text-right py-1.5 pr-2">Resmî</th>
                        <th className="text-right py-1.5 pr-2">Gözlemlenen</th>
                        <th className="text-right py-1.5 pr-2">Öğrenilmiş</th>
                        <th className="text-right py-1.5 pr-2">Tahmini</th>
                        <th className="text-right py-1.5 pr-2">Örnek</th>
                        <th className="text-right py-1.5 pr-2">Güven</th>
                        <th className="text-left py-1.5">Durum</th>
                      </tr>
                    </thead>
                    <tbody>
                      {learnInsights.map(ins => (
                        <tr key={ins.id} className="border-b border-slate-100 dark:border-slate-800/50">
                          <td className="py-1.5 pr-2 font-medium">{ins.marketplaceKey}</td>
                          <td className="py-1.5 pr-2">{ins.category ?? 'Tümü'}</td>
                          <td className="py-1.5 pr-2">{ins.metric}</td>
                          <td className="py-1.5 pr-2 text-right font-mono">{ins.officialValue ?? '—'}</td>
                          <td className="py-1.5 pr-2 text-right font-mono">{ins.observedValue?.toFixed(2)}</td>
                          <td className="py-1.5 pr-2 text-right font-mono">{ins.learnedValue?.toFixed(2)}</td>
                          <td className="py-1.5 pr-2 text-right font-mono">{ins.estimatedValue?.toFixed(2)}</td>
                          <td className="py-1.5 pr-2 text-right font-mono">{ins.sampleCount}</td>
                          <td className="py-1.5 pr-2 text-right font-mono">{(ins.confidence * 100).toFixed(0)}%</td>
                          <td className="py-1.5 pr-2">
                            <span className={`px-1.5 py-0.5 rounded text-[10px] ${ins.status === 'divergent' ? 'bg-red-500/20 text-red-600' : ins.status === 'confirmed' ? 'bg-emerald-500/20 text-emerald-600' : 'bg-slate-500/20 text-slate-500'}`}>{ins.status}</span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>

            {/* Akıllı Uyarılar */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">🔔 Akıllı Uyarılar</h3>
              {learnAlerts.length === 0 ? (
                <div className="text-sm text-current text-center py-4">Aktif uyarı yok.</div>
              ) : (
                <div className="space-y-2">
                  {learnAlerts.map(a => (
                    <div key={a.id} className="p-3 bg-slate-50 dark:bg-slate-800/30 rounded-lg">
                      <div className="flex items-center gap-2">
                        <span className={`text-[10px] px-1.5 py-0.5 rounded ${a.severity === 'critical' ? 'bg-red-500/20 text-red-600' : a.severity === 'warning' ? 'bg-amber-500/20 text-amber-600' : 'bg-sky-500/20 text-sky-600'}`}>{a.severity}</span>
                        <span className="text-sm font-medium text-current">{a.title}</span>
                        <span className="text-xs text-current ml-auto">{a.marketplaceKey} • {a.metric}</span>
                      </div>
                      <div className="text-xs text-current mt-1">{a.message}</div>
                      {a.recommendation && <div className="text-xs text-current/70 mt-1">💡 {a.recommendation}</div>}
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* İzole Senaryo / Simülasyon */}
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">🧪 İzole Senaryo / Simülasyon</h3>
              <p className="text-sm text-current mb-3">Bu simülasyon üretim öğrenme verisini ve DB'yi <b>değiştirmez</b>. Sadece senaryo sonucu üretir.</p>
              <div className="space-y-4">
                <div className="flex flex-wrap gap-3">
                  <label className="flex-1 min-w-[80]">
                    Satış ₺<input id="ss" type="number" value="1000" className="w-full px-2 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg" />
                  </label>
                  <label className="flex-1 min-w-[80]">
                    Maliyet ₺<input id="sc" type="number" value="500" className="w-full px-2 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg" />
                  </label>
                  <label className="flex-1 min-w-[80]">
                    Komisyon %<input id="sk" type="number" value="15" className="w-full px-2 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg" />
                  </label>
                  <label className="flex-1 min-w-[80]">
                    Kargo ₺<input id="sh" type="number" value="60" className="w-full px-2 py-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg" />
                  </label>
                  <button id="srun" onClick={handleSimulate} disabled={simLoading} className="btn-primary px-4 py-2 rounded-lg font-medium w-full">
                    {simLoading ? 'Çalışıyor...' : '▶ Senaryo Çalıştır'}
                  </button>
                </div>
                {simResult && (
                  <div className="mt-4 p-4 bg-slate-50 dark:bg-slate-800/30 rounded-lg">
                    <h4 className="text-sm font-medium text-current mb-2">Simülasyon Sonucu</h4>
                    <div className="space-y-2">
                      <div className="flex items-center justify-between text-current">
                        <span>Net Kâr</span>
                        <span className="font-mono">{formatPrice(simResult?.netProfitCents)}</span>
                      </div>
                      <div className="flex items-center justify-between text-current">
                        <span>Marj %</span>
                        <span className="font-mono">{simResult?.netMarginPercent != null ? `%${simResult.netMarginPercent.toFixed(2)}` : 'VERİ YOK'}</span>
                      </div>
                      <div className="flex items-center justify-between text-current">
                        <span>ROI %</span>
                        <span className="font-mono">{simResult?.roiPercent != null ? `%${simResult.roiPercent.toFixed(2)}` : 'VERİ YOK'}</span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* ===== HESAPLAMA MAKİNESİ ===== */}
        {activeTab === 'hesaplama' && (
          <div className="space-y-6">
            <div className="panel-theme p-6 bg-white dark:bg-slate-800/50 rounded-xl shadow-sm">
              <h3 className="text-sm font-semibold text-current mb-4">🧮 Kâr/Zarar Hesaplama Makinesi</h3>
              <div className="grid gap-4">
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Brüt Satış</label>
                  <input type="number" value={calcInput.grossSales} onChange={e => setCalcInput({...calcInput, grossSales: parseFloat(e.target.value)})} placeholder="Brüt Satış" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">İndirim</label>
                  <input type="number" value={calcInput.discount} onChange={e => setCalcInput({...calcInput, discount: parseFloat(e.target.value)})} placeholder="İndirim" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Ürün Maliyeti</label>
                  <input type="number" value={calcInput.productCost} onChange={e => setCalcInput({...calcInput, productCost: parseFloat(e.target.value)})} placeholder="Ürün Maliyeti" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Komisyon</label>
                  <input type="number" value={calcInput.commission} onChange={e => setCalcInput({...calcInput, commission: parseFloat(e.target.value)})} placeholder="Komisyon" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Kargo</label>
                  <input type="number" value={calcInput.shippingCost} onChange={e => setCalcInput({...calcInput, shippingCost: parseFloat(e.target.value)})} placeholder="Kargo" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Hizmet Bedeli</label>
                  <input type="number" value={calcInput.serviceFee} onChange={e => setCalcInput({...calcInput, serviceFee: parseFloat(e.target.value)})} placeholder="Hizmet Bedeli" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Stopaj</label>
                  <input type="number" value={calcInput.stopaj} onChange={e => setCalcInput({...calcInput, stopaj: parseFloat(e.target.value)})} placeholder="Stopaj" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Reklam</label>
                  <input type="number" value={calcInput.advertising} onChange={e => setCalcInput({...calcInput, advertising: parseFloat(e.target.value)})} placeholder="Reklam" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Pazarlama</label>
                  <input type="number" value={calcInput.marketing} onChange={e => setCalcInput({...calcInput, marketing: parseFloat(e.target.value)})} placeholder="Pazarlama" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">İade</label>
                  <input type="number" value={calcInput.returnCost} onChange={e => setCalcInput({...calcInput, returnCost: parseFloat(e.target.value)})} placeholder="İade" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">Diğer Giderler</label>
                  <input type="number" value={calcInput.otherExpenses} onChange={e => setCalcInput({...calcInput, otherExpenses: parseFloat(e.target.value)})} placeholder="Diğer Giderler" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <label className="text-sm font-medium text-current mb-1">KDV %</label>
                  <input type="number" value={calcInput.vatRate} onChange={e => setCalcInput({...calcInput, vatRate: parseFloat(e.target.value)})} placeholder="KDV %" className="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-800/60 rounded-lg focus:ring-2 focus:ring-primary/50" />
                </div>
                <div className="flex flex-col">
                  <button onClick={handleCalculate} disabled={calcLoading} className="w-full btn-primary py-3 font-medium mt-4">
                    {calcLoading ? 'Hesaplanıyor...' : 'Hesapla'}
                  </button>
                </div>
              </div>
              {calcResult && (
                <div className="mt-6 p-4 bg-slate-50 dark:bg-slate-800/30 rounded-lg">
                  <h4 className="text-sm font-medium text-current mb-2">Hesaplama Sonuçları</h4>
                  <div className="grid gap-3">
                    <div className="flex items-center justify-between text-current">
                      <span>Brüt Satış</span>
                      <span className="font-mono">{formatPrice(calcResult.grossSales)}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>İndirim</span>
                      <span className="font-mono">{formatPrice(calcResult.discount)}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>Net Satış</span>
                      <span className="font-mono">{formatPrice(calcResult.netSales)}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>Toplam Gider</span>
                      <span className="font-mono">{formatPrice((calcResult.productCost||0)+(calcResult.commission||0)+(calcResult.shippingCost||0)+(calcResult.serviceFee||0)+(calcResult.stopaj||0)+(calcResult.advertising||0)+(calcResult.marketing||0)+(calcResult.returnCost||0)+(calcResult.otherExpenses||0))}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>KDV</span>
                      <span className="font-mono">{formatPrice(calcResult.vatPayable)}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>Operasyonel Kâr</span>
                      <span className="font-mono">{formatPrice(calcResult.operationalProfit)}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>Net Kâr</span>
                      <span className="font-mono text-green-600">{formatPrice(calcResult.netProfit)}</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>Marj %</span>
                      <span className="font-mono">{calcResult.profitMargin?.toFixed(2)}%</span>
                    </div>
                    <div className="flex items-center justify-between text-current">
                      <span>ROI %</span>
                      <span className="font-mono">{calcResult.roi?.toFixed(2)}%</span>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}